NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
NSE_MARKET_TIMEZONE=Asia/Kolkata

# Upstox OAuth — server/worker only. Never expose these to the browser.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback
UPSTOX_ACCESS_TOKEN=

UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_MARKET_DATA_V3_URL=

# Supabase — server only. Use the service-role key only in Vercel/server runtime.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FNO_UNIVERSE_REFRESH_HOUR=8
FNO_UNIVERSE_REFRESH_MINUTE=30
